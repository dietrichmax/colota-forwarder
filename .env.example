PORT=3000
API_KEY=your-secret-key

# Incoming endpoints:
#   POST /locations      — Colota native format
#   POST /owntracks      — OwnTracks HTTP format (configure OwnTracks app to point here)
#   GET  /health         — health check

# Targets are forwarded to in parallel.
# TARGET_n_TYPE: "owntracks" | "geopulse" | "traccar" | "colota" | "raw" (default: raw)
# TARGET_n_TID:  tracker ID for owntracks type (default: CL), device ID for traccar type (default: colota)

# Home Assistant — OwnTracks HTTP integration webhook
# Get this URL from: Settings → Devices & Services → OwnTracks → Configure
TARGET_1_URL=http://homeassistant:8123/api/webhook/your-owntracks-webhook-id
TARGET_1_TYPE=owntracks
# TARGET_1_TID=CL      # optional, default: CL
# TARGET_1_USER=colota  # optional, default: colota — sets HA entity name (device_tracker.<user>_<device>)
# TARGET_1_DEVICE=phone # optional, default: phone
# TARGET_1_AUTH= (not needed — HA webhooks are unauthenticated)

# Dawarich
TARGET_2_URL=http://dawarich:3000/api/v1/points
TARGET_2_TYPE=owntracks
TARGET_2_AUTH=Bearer your-dawarich-api-key

# Colota
TARGET_3_URL=http://colota:3000/api/location
TARGET_3_TYPE=colota
TARGET_3_AUTH=Bearer your-colota-api-key

# GeoPulse
TARGET_4_URL=https://geopulse.yourdomain.com/api/colota
TARGET_4_TYPE=geopulse
# TARGET_4_AUTH=Basic base64encodedcredentials

# Traccar (OsmAnd protocol — HTTP GET)
TARGET_5_URL=https://traccar.yourdomain.com:5055
TARGET_5_TYPE=traccar
# TARGET_5_TID=colota  # optional, default: colota — device ID in Traccar

# Reitti
TARGET_6_URL=https://reitti.yourdomain.com/api/v1/ingest/owntracks?token=your-reitti-token
TARGET_6_TYPE=owntracks
