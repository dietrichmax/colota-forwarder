{
  "name": "colota-forwarder",
  "version": "0.1.0",
  "scripts": {
    "dev": "nodemon --watch src/** --watch .env --ext ts,js -I --exec node --experimental-specifier-resolution=node --loader ts-node/esm ./src/server.ts",
    "build": "webpack",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "format": "prettier --write \"**/*.{js,ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md,yml,yaml}\"",
    "check": "npm audit --audit-level=high && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "nodemon": "3.1.14",
    "prettier": "3.9.4",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "webpack": "5.108.3",
    "webpack-cli": "7.1.0"
  }
}
